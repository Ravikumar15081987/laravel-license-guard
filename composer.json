{
    "name": "nirikshaoccesstech/laravel-license-guard",
    "description": "Cryptographic license verification, single-use key enforcement, and emergency override kill-switch management for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nirikshaoccesstech Engineering",
            "email": "dev@nirikshaoccesstech.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nirikshaoccesstech\\LicenseGuard\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nirikshaoccesstech\\LicenseGuard\\LicenseGuardServiceProvider"
            ],
            "aliases": {
                "LicenseGuard": "Nirikshaoccesstech\\LicenseGuard\\Facades\\LicenseGuard"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}